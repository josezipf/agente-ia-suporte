# ============================================================
# .env.example
# Agente de Suporte NOC - ISP
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores com as credenciais do seu ambiente
# 3. NUNCA commite o arquivo .env no Git (já está no .gitignore)
# ============================================================

# ============================================================
# GROQ - LLM
# ============================================================
GROQ_API_KEY=gsk_SUACHIAVEAQUIGROQ
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0
# Tokens máximos do LLM decisor (apenas JSON pequeno)
GROQ_MAX_TOKENS_ROUTER=256
# Tokens máximos do LLM formatador (resposta ao cliente)
GROQ_MAX_TOKENS_FORMATTER=600

# ============================================================
# ZABBIX - Sistema de Monitoramento
# ============================================================
ZABBIX_URL=http://zabbix.sua-empresa.com/api_jsonrpc.php
# Token de API (Zabbix 5.4+) — permissão somente leitura
ZABBIX_TOKEN=SEU_TOKEN_ZABBIX_AQUI
ZABBIX_TIMEOUT=10

# ============================================================
# ANSIBLE - Automação
# ============================================================
ANSIBLE_PLAYBOOKS_DIR=./playbooks
ANSIBLE_INVENTORY=/etc/ansible/hosts
ANSIBLE_TIMEOUT=120
ANSIBLE_VERBOSITY=1
ANSIBLE_USER=admin

# ============================================================
# FASTAPI - Servidor Web
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Origens CORS permitidas (separadas por vírgula) — NUNCA use * em produção
# Exemplo: https://portal.suaempresa.com,https://app.suaempresa.com
CORS_ORIGINS=

# API Key para autenticação dos endpoints (recomendado em produção)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ============================================================
# CONFIGURAÇÕES DO AGENTE
# ============================================================
# Máximo de mensagens por sessão em memória
MAX_HISTORY_MESSAGES=50
# Máximo de mensagens do histórico enviadas ao LLM (economia de tokens)
MAX_HISTORY_TO_LLM=6
# Máximo de sessões simultâneas
MAX_SESSIONS=1000
# Rate limiting por sessão (requisições por janela de tempo)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# CANAL: TELEGRAM (Opcional)
# ============================================================
# Token do Bot do Telegram gerado via @BotFather
TELEGRAM_BOT_TOKEN=
# URL pública exposta do servidor (ex: Ngrok / Cloudflare Tunnel) para registro automático do webhook
# Exemplo: https://sua-url.ngrok-free.app
TELEGRAM_WEBHOOK_URL=

# ============================================================
# CANAL: WHATSAPP CLOUD API (Opcional)
# ============================================================
# Token de acesso temporário ou permanente do desenvolvedor Meta
WHATSAPP_ACCESS_TOKEN=
# ID do número de telefone de teste gerado no painel da Meta
WHATSAPP_PHONE_NUMBER_ID=
# Token de verificação customizado (qualquer texto secreto para validar seu webhook na Meta)
WHATSAPP_VERIFY_TOKEN=
